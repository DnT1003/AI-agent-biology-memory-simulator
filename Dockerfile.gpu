# Dockerfile cho Aura GPU Microservice (SLM & RoBERTa)
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Cai dat Python 3.12 va cac dependencies he thong
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# FIX: Dung python3.12 -m pip thay vi pip3 de dam bao cai dung moi truong
RUN python3.12 -m pip install --upgrade pip

WORKDIR /app

# Cai dat PyTorch ho tro CUDA 12.1
RUN python3.12 -m pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# FIX: Them python-dotenv (config.py can) va requests (da sua typo truoc do)
RUN python3.12 -m pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    transformers \
    colorama \
    requests \
    scipy \
    python-dotenv

# Copy thu muc core va config
COPY core ./core
COPY config.py ./config.py

# Mo cong 8001 cho GPU Service
EXPOSE 8001

# Khoi chay GPU Service voi uvicorn
CMD ["python3.12", "-m", "uvicorn", "core.server.gpu_service:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
