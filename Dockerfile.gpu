# Dockerfile cho Aura GPU Microservice (SLM & RoBERTa)
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Ubuntu 22.04 ships Python 3.10. Use its supported interpreter consistently
# inside a venv instead of requesting unavailable python3.12 packages.
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/aura-venv
ENV PATH="/opt/aura-venv/bin:${PATH}"
RUN python -m pip install --upgrade pip

WORKDIR /app

# Cai dat PyTorch ho tro CUDA 12.1
RUN python -m pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# FIX: Them python-dotenv (config.py can) va requests (da sua typo truoc do)
RUN python -m pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    transformers \
    colorama \
    requests \
    scipy \
    python-dotenv

# Copy thu muc core va config
COPY core ./core
COPY config.py ./config.py

# Mo cong 8001 cho GPU Service
EXPOSE 8001

# Khoi chay GPU Service voi uvicorn
CMD ["python", "-m", "uvicorn", "core.server.gpu_service:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
