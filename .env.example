# Aura Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# DO NOT commit .env to version control.

# --- Core LLM (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI-compatible LLM (provider "openai" in settings) ---
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, or a local
# Ollama/LM Studio server. Local servers need no key and bypass the proxy.
# AURA_OPENAI_BASE_URL=http://localhost:11434/v1
# AURA_OPENAI_MODEL=qwen3:8b
# OPENAI_API_KEY=

# --- Vector Store (ChromaDB) ---
# Optional canonical durable root. Leave unset to retain the legacy
# AURA_OUTPUT_DIR -> outputs compatibility layout until promotion.
# AURA_DATA_DIR=
# Set USE_CHROMA_SERVER=True to use the REST client (Standard for Aura)
USE_CHROMA_SERVER=True
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=8000
CHROMA_DB_PATH=outputs/chroma_db

# --- Memory Server Security ---
# Basic token for destructive operations (/clear, /delete)
AURA_MEM_TOKEN=aura_secret_default_change_me

# --- GPU / SLM Service ---
SLM_PORT=8001
# GPU Microservice Authentication (M4.1b): required internal token for inference and health endpoints.
# ASCII token68/base64url-like string, length 32..256, no whitespace/control characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Intentionally left empty so that the GPU service fails closed by default until configured.
# Do not place any public string here that could pass validator.
AURA_GPU_SERVICE_AUTH_TOKEN=
# Sentiment model loaded by the GPU service (HuggingFace id). Labels must be
# negative/neutral/positive, NEG/NEU/POS, or CardiffNLP-ordered LABEL_0..2.
# AURA_LOCAL_PERCEPTION_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual

# --- Sleep ---
# true: non-urgent messages wait until Aura wakes up (~07:00) instead of
# waking her; urgent wording ("gấp", "ngay", "!!") still wakes her.
# AURA_DEFER_REPLIES_WHILE_ASLEEP=false

# --- Event Journal Integrity ---
# Shared HMAC key used by every process that writes to the event journal.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Intentionally empty: set a fresh private value before enabling a deployment.
AURA_EVENT_JOURNAL_HMAC_KEY=

# --- Dashboard ---
DASHBOARD_PORT=8050
# Dashboard Bearer Authentication (M4.1a): required service token for all /api endpoints.
# ASCII token68/base64url-like string, length 32..256, no whitespace/control characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Intentionally left empty so that the dashboard fails closed by default until configured.
# Do not place any public string here that could pass validator.
AURA_DASHBOARD_AUTH_TOKEN=

# --- Development / Safety ---
# Set to True only if you are developing and testing new skills locally
ALLOW_DYNAMIC_SKILLS=False
