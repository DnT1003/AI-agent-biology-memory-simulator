# Aura dashboard serves both the UI and its same-origin FastAPI endpoints.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.100.0" \
    "uvicorn>=0.23.0" \
    "python-dotenv>=1.0.0"

COPY config.py ./config.py
COPY core/__init__.py core/settings_manager.py core/utils.py ./core/
COPY dashboard/ ./dashboard/

RUN mkdir -p /app/outputs

EXPOSE 8050

HEALTHCHECK --interval=10s --timeout=3s \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8050/', timeout=2).read(1)"]

CMD ["python", "-m", "uvicorn", "dashboard.server:app", "--host", "0.0.0.0", "--port", "8050", "--workers", "1"]
